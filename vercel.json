{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public-dist",
  "functions": { "api/chat.js": { "maxDuration": 60, "includeFiles": "server/**" } },
  "headers": [{ "source": "/assets/chat/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }]
}
